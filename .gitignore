# ==============================================================================
# NEXORA DIGITAL STUDIO - COMPREHENSIVE .GITIGNORE
# ==============================================================================
# Prevents accidental commits of secrets, environmental variables, credentials,
# logs, temporary artifacts, and OS system files.

# Environment & Secrets (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# Server & Application Logs
*.log
logs/
*.pid
*.seed

# Temporary Backups & Archives
original_backup/
nexor-main/
backup/
backups/
*.bak
*.old
*.orig
*~
scratch/
.system_generated/
