# ==============================================================================
# NEXORA DIGITAL STUDIO - ENVIRONMENT SECURITY CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure your production environment variables.
# NEVER commit your actual .env file or real credentials to Git!

# Server Configuration
PORT=8888
NODE_ENV=production

# Security & Session Secrets
# Generate a high-entropy 64-character secret for token/session signing
SESSION_SECRET=generate_a_random_64_character_hex_secret_here

# Admin Authentication
# Salt and SHA-256 Hashes for Admin Portal (Never store plaintext credentials)
ADMIN_SALT=nexora_salt_9e3b7c84f1a26d
ADMIN_PHONE_HASH=3849703be842a429f3bd7d19c6f43749b36f6d8f40c84f8592bb79e7eaee3534
ADMIN_PASSWORD_HASH=c8a2ea9af5d8708e53ad0e6f8276e0ff5d47d72b7e59e238f2d46c181bafbd9b

# CORS & Rate Limiting Controls
ALLOWED_ORIGIN=https://nexora-agency-website.vercel.app
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Optional Third-Party Services (Keep strictly server-side!)
# EMAIL_SERVICE_API_KEY=
# RECAPTCHA_SECRET_KEY=
# DATABASE_URL=
